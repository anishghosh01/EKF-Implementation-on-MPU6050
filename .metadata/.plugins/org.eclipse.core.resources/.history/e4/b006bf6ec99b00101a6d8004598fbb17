// MPU6050 data structure
MPU6050_t MPU6050_Data;

// New EKF structure
New_EKF_t ekf;

I2C_HandleTypeDef hi2c1;

UART_HandleTypeDef huart2;


void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_I2C1_Init(void);
static void MX_USART2_UART_Init(void);

#define RAD_TO_DEG (180.0f / 3.1415926535f)
#define DEG_TO_RAD (3.1415926535f / 180.0f)
#define G_MPS2 9.80665f

// For printf redirection
#ifdef __GNUC__
#define PUTCHAR_PROTOTYPE int __io_putchar(int ch)
#else
#define PUTCHAR_PROTOTYPE int fputc(int ch, FILE *f)
#endif

PUTCHAR_PROTOTYPE
{
  HAL_UART_Transmit(&huart2, (uint8_t *)&ch, 1, HAL_MAX_DELAY);
  return ch;
}


int main(void)
{
	uint32_t last_time;
	float dt;
	uint32_t current_time;

  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART2_UART_Init();

  printf("System Initialized. Starting MPU6050 and New EKF...\r\n");

    while (MPU6050_Init(&hi2c1) == 1)
    {
      printf("MPU6050 Init Failed. Retrying...\r\n");
      HAL_Delay(500);
    }
    printf("MPU6050 Initialized Successfully.\r\n");

    // --- CRITICAL STEP: Calibrate Gyroscope ---
      printf("Keep sensor stationary for gyroscope calibration...\r\n");
      MPU6050_Calibrate_Gyro(&hi2c1, &MPU6050_Data, 2000);
      printf("Calibration complete.\r\n");

//      // --- EKF TUNING PARAMETERS (Based on Video/GitHub) ---
//      float P_initial[2] = {1.0f, 1.0f};
//      float Q_process[2] = {0.02f, 0.02f};
//      float R_measurement[3] = {0.2f, 0.2f, 0.2f};

      // --- EKF TUNING PARAMETERS ---
      // Increased Q and decreased R to make the filter more responsive
      float P_initial[2] = {1.0f, 1.0f};
      // Increased Q: Trust the gyroscope less, react faster to accelerometer.
      float Q_process[2] = {0.1f, 0.1f};
      // Decreased R: Trust the accelerometer more, apply corrections more aggressively.
      float R_measurement[3] = {0.05f, 0.05f, 0.05f};

      New_EKF_Init(&ekf, P_initial, Q_process, R_measurement);
      printf("New EKF Initialized.\r\n");

      last_time = HAL_GetTick();
      dt = 0.0f;

      while (1)
      {
    	    current_time = HAL_GetTick();
    	    dt = (current_time - last_time) / 1000.0f;
    	    last_time = current_time;
    	    if (dt <= 0) {
    	    	dt = 0.01f;
    	    }

    	    MPU6050_Read_All(&hi2c1, &MPU6050_Data);

    	    New_EKF_Predict(&ekf,
    	                MPU6050_Data.Gx, MPU6050_Data.Gy, MPU6050_Data.Gz, // Gyro in rad/s
    	                dt);

    	    New_EKF_Update(&ekf,
    	               MPU6050_Data.Ax * G_MPS2, MPU6050_Data.Ay * G_MPS2, MPU6050_Data.Az * G_MPS2); // Accel in m/s^2

    	    // New line
    	    printf("%.2f,%.2f\r\n", (ekf.x_est_data[0] * RAD_TO_DEG), (ekf.x_est_data[1] * RAD_TO_DEG));

    	    HAL_Delay(10);
      }

}






