void EKF_Task(void *argument)
{
  uint32_t last_time;
  float dt;

  // --- Initialize MPU6050 ---
  while (MPU6050_Init(&hi2c1) == 1)
  {
    printf("MPU6050 Init Failed. Retrying...\r\n");
    vTaskDelay(pdMS_TO_TICKS(500));
  }
  printf("MPU6050 Initialized Successfully.\r\n");

  // --- Calibrate Gyroscope ---
  printf("Keep sensor stationary for gyroscope calibration...\r\n");
  MPU6050_Calibrate_Gyro(&hi2c1, &MPU6050_Data, 2000);
  printf("Calibration complete.\r\n");

  // --- EKF Tuning Parameters ---
  float P_initial[2] = {1.0f, 1.0f};
  float Q_process[2] = {0.1f, 0.1f};
  float R_measurement[3] = {0.05f, 0.05f, 0.05f};
  New_EKF_Init(&ekf, P_initial, Q_process, R_measurement);
  printf("New EKF Initialized.\r\n\n");

  last_time = xTaskGetTickCount();

  for(;;)
  {
      uint32_t current_time = xTaskGetTickCount();
      dt = (current_time - last_time) / (float)configTICK_RATE_HZ;
      last_time = current_time;

      if (dt <= 0) {
          dt = 1.0f / (float)configTICK_RATE_HZ;
      }

      // --- Read Sensor Data ---
      MPU6050_Read_All(&hi2c1, &MPU6050_Data);

      // +++ NEW: Calculate raw angles from accelerometer for comparison +++
      float raw_roll_rad = atan2f(MPU6050_Data.Ay, MPU6050_Data.Az);
      float raw_pitch_rad = atan2f(-MPU6050_Data.Ax, sqrtf(MPU6050_Data.Ay * MPU6050_Data.Ay + MPU6050_Data.Az * MPU6050_Data.Az));

      // --- EKF Predict Step ---
      New_EKF_Predict(&ekf,
                      MPU6050_Data.Gx, MPU6050_Data.Gy, MPU6050_Data.Gz,
                      dt);

      // --- EKF Update Step ---
      New_EKF_Update(&ekf,
                     MPU6050_Data.Ax * G_MPS2, MPU6050_Data.Ay * G_MPS2, MPU6050_Data.Az * G_MPS2);

      // +++ MODIFIED: Print both raw and filtered values in CSV format +++
      printf("%.2f,%.2f,%.2f,%.2f\r\n",
             raw_roll_rad * RAD_TO_DEG,
             raw_pitch_rad * RAD_TO_DEG,
             ekf.x_est_data[0] * RAD_TO_DEG,
             ekf.x_est_data[1] * RAD_TO_DEG);

      // --- Delay to maintain loop frequency ---
      vTaskDelay(pdMS_TO_TICKS(10));
  }
}

